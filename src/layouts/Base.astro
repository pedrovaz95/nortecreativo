---
import Logo from '../components/Logo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Nortecreativo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Manrope:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" aria-label="Ir al inicio de Nortecreativo">
          <Logo />
        </a>
        <nav class="site-nav">
          <a href="/#servicios">Servicios</a>
          <a href="/#portafolio">Portafolio</a>
          <a href="/#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <Logo withWordmark={false} size={22} />
        <span class="mono footer-note">nortecreativo.com</span>
      </div>
    </footer>

    <script>
      // Revela con una animación suave los elementos marcados .reveal /
      // .reveal-stagger según entran en pantalla. Si el navegador no
      // soporta IntersectionObserver, o el visitante pidió "reducir
      // movimiento", el contenido se queda visible tal cual (ver
      // global.css: sin la clase "js" en <html>, nada se oculta).
      (function () {
        var html = document.documentElement;
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) html.classList.add('reduced-motion');
        if (!('IntersectionObserver' in window)) return;

        html.classList.add('js');

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-stagger').forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 78%, transparent);
        backdrop-filter: blur(16px) saturate(160%);
        -webkit-backdrop-filter: blur(16px) saturate(160%);
        border-bottom: 1px solid color-mix(in srgb, var(--line) 65%, transparent);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
      }
      .site-nav {
        display: flex;
        gap: 6px;
      }
      .site-nav a {
        position: relative;
        display: inline-block;
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        padding: 8px 14px;
        border-radius: var(--radius-pill);
        transition: background 200ms var(--ease-out), color 200ms var(--ease-out);
      }
      .site-nav a:hover {
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 12%, transparent);
      }
      .site-footer {
        margin-top: 80px;
        border-top: 1px solid var(--line);
        padding: 28px 24px;
      }
      .site-footer .wrap {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .footer-note {
        color: var(--muted);
        font-size: 13px;
      }

      @media (max-width: 640px) {
        .header-inner {
          flex-wrap: wrap;
          row-gap: 12px;
          padding: 16px 28px;
        }
        .site-nav {
          width: 100%;
          gap: 18px;
        }
        .site-nav a {
          font-size: 14px;
        }
      }
    </style>
  </body>
</html>
