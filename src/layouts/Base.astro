---
import Logo from '../components/Logo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Nortecreativo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Manrope:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="site-cloud" aria-hidden="true">
      <span class="cloud-blob cloud-blob-a"></span>
      <span class="cloud-blob cloud-blob-b"></span>
    </div>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" aria-label="Ir al inicio de Nortecreativo">
          <Logo interactive />
        </a>
        <nav class="site-nav">
          <a href="/#servicios">Servicios</a>
          <a href="/#portafolio">Portafolio</a>
          <a href="/#contacto">Contacto</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <Logo withWordmark={false} size={22} />
        <span class="mono footer-note">nortecreativo.com</span>
      </div>
    </footer>

    <script>
      // Revela con una animación suave los elementos marcados .reveal /
      // .reveal-stagger según entran en pantalla. Si el navegador no
      // soporta IntersectionObserver, o el visitante pidió "reducir
      // movimiento", el contenido se queda visible tal cual (ver
      // global.css: sin la clase "js" en <html>, nada se oculta).
      (function () {
        var html = document.documentElement;
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) html.classList.add('reduced-motion');
        if (!('IntersectionObserver' in window)) return;

        html.classList.add('js');

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-stagger').forEach(function (el) {
          io.observe(el);
        });
      })();

      // Parallax sutil del hero: al bajar, el bloque de texto se desplaza
      // y se apaga un poco. Es la parte "cinética" del título editorial.
      // Se salta por completo si el visitante pidió reducir movimiento.
      (function () {
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var hero = document.querySelector('[data-parallax]');
        if (!hero || reduce) return;

        var ticking = false;
        function update() {
          var rect = hero.getBoundingClientRect();
          var heroHeight = hero.offsetHeight || 600;
          var progress = Math.min(Math.max(-rect.top / heroHeight, 0), 1);
          hero.style.setProperty('--p', progress.toFixed(3));
          ticking = false;
        }
        window.addEventListener(
          'scroll',
          function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
        update();
      })();

      // Nube líquida naranja que sigue el cursor por toda la página,
      // con inercia (no se pega a la posición exacta del mouse, va
      // detrás con un poco de peso) — el mismo principio de "un
      // elemento que responde de verdad" que ya tiene la aguja del
      // logo, aquí como un rastro ambiental en vez de un ícono. Fixed
      // sobre toda la ventana (no depende del scroll), se mezcla en
      // modo "screen" así que nunca tapa el texto ni los fondos
      // oscuros. Se desactiva por completo con "reducir movimiento" o
      // en pantallas táctiles (ahí no hay cursor que perseguir).
      (function () {
        var cloud = document.querySelector('.site-cloud');
        if (!cloud) return;

        var fineHover =
          window.matchMedia &&
          window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        var reduce =
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!fineHover || reduce) return;

        var blobs = Array.prototype.slice.call(cloud.querySelectorAll('.cloud-blob'));
        var lag = [0.1, 0.06]; // la segunda mancha va más rezagada: da sensación de peso
        var pos = blobs.map(function () {
          return { x: 0, y: 0 };
        });
        var target = { x: 0, y: 0 };
        var running = false;
        var started = false;

        function loop() {
          blobs.forEach(function (blob, i) {
            pos[i].x += (target.x - pos[i].x) * lag[i];
            pos[i].y += (target.y - pos[i].y) * lag[i];
            blob.style.transform =
              'translate(' + pos[i].x.toFixed(1) + 'px,' + pos[i].y.toFixed(1) + 'px)';
          });
          if (running) requestAnimationFrame(loop);
        }

        window.addEventListener(
          'pointermove',
          function (e) {
            target.x = e.clientX;
            target.y = e.clientY;
            if (!started) {
              started = true;
              pos.forEach(function (p) {
                p.x = e.clientX;
                p.y = e.clientY;
              });
              cloud.classList.add('is-active');
            }
            if (!running) {
              running = true;
              requestAnimationFrame(loop);
            }
          },
          { passive: true }
        );

        document.addEventListener('mouseleave', function () {
          cloud.classList.remove('is-active');
        });
      })();
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        /* Sólido, no vidrio esmerilado: con la franja de niveles y el
           panel del portafolio ahora hay secciones oscuras de sobra
           pasando debajo del header, y el blur dejaba pasar ese
           contraste (se leía texto fantasma encima del logo al hacer
           scroll). Un fondo opaco es más simple y no tiene ese riesgo. */
        background: var(--bg);
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
      }
      .site-nav {
        display: flex;
        gap: 6px;
      }
      .site-nav a {
        position: relative;
        display: inline-block;
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        padding: 8px 14px;
        border-radius: var(--radius-pill);
        transition: background 200ms var(--ease-out), color 200ms var(--ease-out);
      }
      .site-nav a:hover {
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 12%, transparent);
      }
      .site-footer {
        margin-top: 80px;
        border-top: 1px solid var(--line);
        padding: 28px 24px;
      }
      .site-footer .wrap {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .footer-note {
        color: var(--muted);
        font-size: 13px;
      }

      @media (max-width: 640px) {
        .header-inner {
          flex-wrap: wrap;
          row-gap: 12px;
          padding: 16px 28px;
        }
        .site-nav {
          width: 100%;
          gap: 18px;
        }
        .site-nav a {
          font-size: 14px;
        }
      }
    </style>
  </body>
</html>
