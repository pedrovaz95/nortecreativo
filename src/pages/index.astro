    <rect x="86" y="60" width="67" height="40" fill="var(--deep-accent)" fill-opacity="0.18" stroke="var(--deep-accent)" stroke-width="1.5"/>
    <line x1="102" y1="76" x2="136" y2="76" stroke="var(--deep-accent)" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="102" y1="86" x2="124" y2="86" stroke="var(--deep-accent)" stroke-width="2.5" stroke-linecap="round"/>
