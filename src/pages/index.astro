    <polygon points="34,58 34,102 58,80" fill="var(--deep-accent)"/>
    <g stroke="var(--deep-accent)" stroke-width="4" stroke-linecap="round">
      <line x1="86" y1="70" x2="86" y2="90"/>
      <line x1="98" y1="55" x2="98" y2="105"/>
      <line x1="110" y1="40" x2="110" y2="120"/>
      <line x1="122" y1="60" x2="122" y2="100"/>
      <line x1="134" y1="45" x2="134" y2="115"/>
      <line x1="146" y1="65" x2="146" y2="95"/>
      <line x1="158" y1="35" x2="158" y2="125"/>
      <line x1="170" y1="58" x2="170" y2="102"/>
      <line x1="182" y1="72" x2="182" y2="88"/>
      <line x1="194" y1="50" x2="194" y2="110"/>
