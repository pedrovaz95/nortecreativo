    <rect x="46" y="18" width="178" height="112" rx="8" fill="var(--deep-bg)" stroke="var(--deep-accent)" stroke-width="2"/>
    <line x1="46" y1="42" x2="224" y2="42" stroke="var(--deep-accent)" stroke-width="1.5"/>
    <circle cx="58" cy="30" r="3" fill="var(--deep-accent)"/>
    <circle cx="70" cy="30" r="3" fill="var(--deep-line)"/>
    <circle cx="82" cy="30" r="3" fill="var(--deep-line)"/>
    <line x1="62" y1="60" x2="150" y2="60" stroke="var(--deep-line)" stroke-width="2" stroke-linecap="round"/>
