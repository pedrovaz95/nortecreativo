    <circle cx="220" cy="22" r="4.5" fill="var(--deep-accent)"/>
  </svg>`,
  // 01 · Calculadora para distribuidores — ficha de cálculo
  `<svg viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
