---
import Base from '../layouts/Base.astro';

const lineas = [
  {
    titulo: 'Marca y contenido',
    desc: 'Identidad visual, piezas para redes, campañas, presentaciones, guiones, video y contenido con apoyo de IA.',
  },
  {
    titulo: 'Experiencias digitales',
    desc: 'Landing pages, micrositios, catálogos digitales, formularios, calculadoras, simuladores y herramientas interactivas.',
  },
  {
    titulo: 'IA y automatización',
    desc: 'Asistentes internos, generación de contenido, flujos de trabajo y automatización de tareas repetitivas.',
  },
  {
    titulo: 'Ventas y capacitación',
    desc: 'Material para equipos comerciales, cursos, guías, recursos de venta y sistemas de consulta.',
  },
];

const niveles = [
  {
    nombre: 'Norte Inicio',
    precio: '$4,000–$10,000 MXN',
    desc: 'Para resolver algo puntual.',
    ejemplos: 'Landing page, presentación comercial, kit para redes, catálogo digital, automatización sencilla.',
  },
  {
    nombre: 'Norte Crece',
    precio: '$10,000–$30,000 MXN',
    desc: 'Para negocios que ya operan.',
    ejemplos: 'Sitio + contenido + automatización, sistema comercial, catálogo interactivo, capacitación, seguimiento.',
  },
  {
    nombre: 'Norte Lab',
    precio: 'Desde $20,000–$25,000 MXN',
    desc: 'Soluciones desde cero, a cotización.',
    ejemplos: 'Simuladores, sistemas internos, apps web ligeras, experiencias con IA, proyectos que mezclan disciplinas.',
  },
];

const portafolio = [
  {
    tag: 'Vender mejor',
    titulo: 'Simulador de ganancias',
    desc: 'Convierte reglas comerciales complejas en una proyección sencilla: el usuario captura sus datos y ve el resultado.',
  },
  {
    tag: 'Vender mejor',
    titulo: 'Calculadora para distribuidores',
    desc: 'Prototipo para proyectar resultados y apoyar conversaciones comerciales con nuevos distribuidores.',
  },
  {
    tag: 'Comunicar mejor',
    titulo: 'Producción de contenido comercial',
    desc: 'Guiones, video, campañas y piezas para redes de una marca de venta directa.',
  },
  {
    tag: 'Capacitar mejor',
    titulo: 'Plataforma de capacitación',
    desc: 'Experiencia de aprendizaje con video, evaluaciones, reconocimientos y seguimiento.',
  },
  {
    tag: 'Operar mejor',
    titulo: 'Registro de eventos por código QR',
    desc: 'Registra asistentes, eventos y regiones, y después ordena la información recolectada.',
  },
  {
    tag: 'Crear algo nuevo',
    titulo: 'Presentación interactiva en la web',
    desc: 'Una presentación tradicional convertida en experiencia web, con navegación y materiales descargables.',
  },
];
---

<Base
  title="Soluciones de marca, contenido y tecnología para pymes"
  description="Nortecreativo crea soluciones para pequeños negocios combinando creatividad, tecnología e IA — de una marca a una herramienta digital hecha para resolver un problema real."
>
  <section class="hero-section">
    <div class="hero-glow hero-glow-accent" aria-hidden="true"></div>
    <div class="hero-glow hero-glow-ink" aria-hidden="true"></div>
    <div class="hero wrap">
      <span class="eyebrow mono reveal d1">Nortecreativo</span>
      <h1 class="reveal d2">Resolvemos problemas de negocio con diseño y tecnología.</h1>
      <p class="lead reveal d3">
        Marca, contenido, herramientas digitales y automatización con IA. No
        entregamos solo un archivo — resolvemos el problema detrás.
      </p>
      <div class="cta-row reveal d4">
        <a class="btn btn-primary" href="#contacto">Cuéntame tu proyecto</a>
        <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
      </div>
      <div class="contraste reveal d5">
        <p class="antes"><span class="mono tag">antes</span> "Te hago una página web."</p>
        <p class="ahora">
          <span class="mono tag accent">ahora</span> Una solución para vender, comunicar
          u operar mejor tu negocio.
        </p>
      </div>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="wrap">
      <span class="eyebrow mono reveal">Servicios</span>
      <h2 class="reveal">Cuatro líneas. Casi siempre se combinan.</h2>
      <div class="grid grid-2 reveal-stagger">
        {
          lineas.map((l, i) => (
            <div class="card">
              <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{l.titulo}</h3>
              <p>{l.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-deep">
    <div class="wrap">
      <span class="eyebrow mono reveal">Niveles</span>
      <h2 class="reveal">Del tamaño de tu problema.</h2>
      <div class="grid grid-3 reveal-stagger">
        {
          niveles.map((n, i) => (
            <div class="card card-nivel">
              <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{n.nombre}</h3>
              <p class="precio mono">{n.precio}</p>
              <p class="nivel-desc">{n.desc}</p>
              <p class="nivel-ejemplos">{n.ejemplos}</p>
            </div>
          ))
        }
      </div>
      <p class="nota">
        Precios de referencia para arrancar — cada proyecto se cotiza según
        alcance. También hay servicios mensuales de contenido, diseño y
        automatización, desde $6,000 MXN al mes.
      </p>
    </div>
  </section>

  <section id="portafolio" class="section">
    <div class="wrap">
      <span class="eyebrow mono reveal">Portafolio</span>
      <h2 class="reveal">Seis proyectos. Un problema distinto cada uno.</h2>
      <div class="grid grid-3 reveal-stagger">
        {
          portafolio.map((p, i) => (
            <div class="card">
              <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="mono tag accent">{p.tag}</span>
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section section-cta">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="wrap contacto">
      <span class="eyebrow mono reveal">Contacto</span>
      <h2 class="reveal">Hablemos de tu proyecto.</h2>
      <p class="lead reveal">
        Cuéntame qué necesitas resolver. Te respondo con una propuesta clara
        y sin rodeos.
      </p>
      <div class="cta-row reveal">
        <a
          class="btn btn-primary"
          href="https://wa.me/524433289922"
          target="_blank"
          rel="noopener"
          >Escribir por WhatsApp</a
        >
        <a class="btn btn-ghost" href="mailto:hola@nortecreativo.com"
          >hola@nortecreativo.com</a
        >
      </div>
    </div>
  </section>

  <style>
    .hero-section {
      position: relative;
      overflow: hidden;
    }
    .hero-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
      pointer-events: none;
    }
    .hero-glow-accent {
      width: 560px;
      height: 560px;
      top: -220px;
      right: -160px;
      background: var(--accent);
      opacity: 0.28;
    }
    .hero-glow-ink {
      width: 460px;
      height: 460px;
      bottom: -260px;
      left: -180px;
      background: var(--ink);
      opacity: 0.06;
    }
    .hero {
      position: relative;
      padding-top: clamp(72px, 14vh, 160px);
      padding-bottom: clamp(56px, 8vh, 96px);
      max-width: 720px;
    }
    .eyebrow {
      display: block;
      color: var(--accent);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }
    h1 {
      font-size: clamp(36px, 6.6vw, 76px);
      letter-spacing: -0.025em;
      line-height: 1.03;
      margin-bottom: 22px;
    }
    .lead {
      color: var(--muted);
      font-size: 19px;
      max-width: 52ch;
      margin: 0 0 36px;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 44px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 15px 28px;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      border-radius: var(--radius-pill);
      border: 1px solid transparent;
      transition: transform 200ms var(--ease-out), background 200ms var(--ease-out),
        border-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
    }
    .btn:active {
      transform: scale(0.97);
    }
    .btn-primary {
      background: var(--accent);
      color: var(--accent-ink);
    }
    @media (hover: hover) and (pointer: fine) {
      .btn-primary:hover {
        box-shadow: 0 16px 36px -12px color-mix(in srgb, var(--accent) 75%, transparent);
        transform: translateY(-2px);
      }
      .btn-ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-2px);
      }
    }
    .btn-ghost {
      color: var(--ink);
      border-color: var(--line);
    }
    .contraste {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px 28px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    .contraste p {
      margin: 0 0 10px;
      font-size: 16px;
    }
    .contraste .antes {
      color: var(--muted);
      text-decoration: line-through;
      text-decoration-color: var(--muted);
      text-decoration-thickness: 1.5px;
    }
    .contraste .ahora {
      color: var(--ink);
      font-weight: 700;
      font-size: 19px;
      margin-bottom: 0;
    }
    .tag {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-right: 10px;
    }
    .tag.accent {
      color: var(--accent);
    }

    .section {
      padding: clamp(64px, 12vh, 140px) 0;
    }
    .section h2 {
      font-size: clamp(28px, 4.4vw, 44px);
      letter-spacing: -0.01em;
      margin: 0 0 40px;
      max-width: 32ch;
    }

    /* Franja oscura fija — quiebra el ritmo visual entre secciones,
       como los bloques de contraste que usan sitios de referencia
       (Apple, agencias de diseño): no depende del modo claro/oscuro
       del sistema, siempre se ve como una pausa intencional. */
    .section-deep {
      background: var(--deep-bg);
      color: var(--deep-text);
    }
    .section-deep .eyebrow {
      color: var(--deep-accent);
    }
    .section-deep h2 {
      color: var(--deep-text);
    }
    .section-deep .card {
      background: var(--deep-card);
      border-color: var(--deep-line);
      box-shadow: none;
    }
    .section-deep .card-index {
      color: var(--deep-text);
    }
    .section-deep .card-nivel h3 {
      color: var(--deep-accent);
    }
    .section-deep .precio,
    .section-deep .nivel-desc {
      color: var(--deep-text);
    }
    .section-deep .nivel-ejemplos,
    .section-deep .nota {
      color: var(--deep-muted);
    }
    @media (hover: hover) and (pointer: fine) {
      .section-deep .card:hover {
        border-color: var(--deep-accent);
        box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.6);
      }
    }

    .grid {
      display: grid;
      gap: 22px;
      margin-bottom: 20px;
    }
    .grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .card {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      padding: 32px 28px 28px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: transform 260ms var(--ease-out), border-color 260ms var(--ease-out),
        box-shadow 260ms var(--ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .card:hover {
        transform: translateY(-6px);
        border-color: var(--accent);
        box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.4);
      }
    }
    .card-index {
      position: absolute;
      top: 6px;
      right: 20px;
      z-index: -1;
      font-family: var(--font-display);
      font-size: 72px;
      font-weight: 800;
      color: var(--ink);
      opacity: 0.06;
      line-height: 1;
    }
    .card h3 {
      font-size: 19px;
      margin: 0 0 10px;
    }
    .card p {
      color: var(--muted);
      font-size: 15px;
      margin: 0;
    }
    .card-nivel {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .card-nivel h3 {
      color: var(--accent);
      margin-bottom: 2px;
    }
    .precio {
      font-size: 22px;
      color: var(--ink);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .nivel-desc {
      color: var(--ink);
      font-weight: 600;
      font-size: 15px;
    }
    .nivel-ejemplos {
      color: var(--muted);
      font-size: 14px;
    }
    .nota {
      color: var(--muted);
      font-size: 14px;
      font-style: italic;
      margin-top: 8px;
    }

    .section-cta {
      position: relative;
      overflow: hidden;
    }
    .cta-glow {
      position: absolute;
      width: 640px;
      height: 640px;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      background: var(--accent);
      opacity: 0.08;
      border-radius: 50%;
      filter: blur(120px);
      pointer-events: none;
    }
    .contacto {
      position: relative;
      max-width: 560px;
    }

    @media (max-width: 780px) {
      .grid-2,
      .grid-3 {
        grid-template-columns: 1fr;
      }
      .hero-glow-accent,
      .hero-glow-ink {
        opacity: 0.16;
      }
    }
  </style>
</Base>
