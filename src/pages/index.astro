      <circle cx="40" cy="110" r="3"/><circle cx="80" cy="110" r="3"/><circle cx="120" cy="110" r="3"/><circle cx="160" cy="110" r="3"/><circle cx="200" cy="110" r="3"/>
      <circle cx="40" cy="140" r="3"/><circle cx="80" cy="140" r="3"/><circle cx="120" cy="140" r="3"/><circle cx="160" cy="140" r="3"/><circle cx="200" cy="140" r="3"/>
    </g>
    <polyline points="40,30 80,70 120,70 160,110 200,110" stroke="var(--deep-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="40" cy="30" r="5.5" fill="var(--deep-accent)"/>
