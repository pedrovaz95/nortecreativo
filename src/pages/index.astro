---
import Base from '../layouts/Base.astro';

const lineas = [
  {
    titulo: 'Marca y contenido',
    rumbo: '000°',
    desc: 'Identidad visual, piezas para redes, campañas, presentaciones, guiones, video y contenido con apoyo de IA.',
  },
  {
    titulo: 'Experiencias digitales',
    rumbo: '090°',
    desc: 'Landing pages, micrositios, catálogos digitales, formularios, calculadoras, simuladores y herramientas interactivas.',
  },
  {
    titulo: 'IA y automatización',
    rumbo: '180°',
    desc: 'Asistentes internos, generación de contenido, flujos de trabajo y automatización de tareas repetitivas.',
  },
  {
    titulo: 'Ventas y capacitación',
    rumbo: '270°',
    desc: 'Material para equipos comerciales, cursos, guías, recursos de venta y sistemas de consulta.',
  },
];

const niveles = [
  {
    nombre: 'Norte Inicio',
    precio: '$4,000–$10,000 MXN',
    desc: 'Para resolver algo puntual.',
    ejemplos: 'Landing page, presentación comercial, kit para redes, catálogo digital, automatización sencilla.',
  },
  {
    nombre: 'Norte Crece',
    precio: '$10,000–$30,000 MXN',
    desc: 'Para negocios que ya operan.',
    ejemplos: 'Sitio + contenido + automatización, sistema comercial, catálogo interactivo, capacitación, seguimiento.',
  },
  {
    nombre: 'Norte Lab',
    precio: 'Desde $20,000–$25,000 MXN',
    desc: 'Soluciones desde cero, a cotización.',
    ejemplos: 'Simuladores, sistemas internos, apps web ligeras, experiencias con IA, proyectos que mezclan disciplinas.',
  },
];

const portafolio = [
  {
    tag: 'Vender mejor',
    titulo: 'Simulador de ganancias',
    desc: 'Convierte reglas comerciales complejas en una proyección sencilla: el usuario captura sus datos y ve el resultado.',
  },
  {
    tag: 'Vender mejor',
    titulo: 'Calculadora para distribuidores',
    desc: 'Prototipo para proyectar resultados y apoyar conversaciones comerciales con nuevos distribuidores.',
  },
  {
    tag: 'Comunicar mejor',
    titulo: 'Producción de contenido comercial',
    desc: 'Guiones, video, campañas y piezas para redes de una marca de venta directa.',
  },
  {
    tag: 'Capacitar mejor',
    titulo: 'Plataforma de capacitación',
    desc: 'Experiencia de aprendizaje con video, evaluaciones, reconocimientos y seguimiento.',
  },
  {
    tag: 'Operar mejor',
    titulo: 'Registro de eventos por código QR',
    desc: 'Registra asistentes, eventos y regiones, y después ordena la información recolectada.',
  },
  {
    tag: 'Crear algo nuevo',
    titulo: 'Presentación interactiva en la web',
    desc: 'Una presentación tradicional convertida en experiencia web, con navegación y materiales descargables.',
  },
];
---

<Base
  title="Soluciones de marca, contenido y tecnología para pymes"
  description="Nortecreativo crea soluciones para pequeños negocios combinando creatividad, tecnología e IA — de una marca a una herramienta digital hecha para resolver un problema real."
>
  <section class="hero-section">
    <div class="hero wrap" data-parallax>
      <div class="hero-title-block">
        <span class="eyebrow mono reveal d1">Nortecreativo</span>
        <h1 class="hero-title">
          <span class="line line-1 reveal d2">Resolvemos</span>
          <span class="line line-2 reveal d3">problemas de negocio</span>
          <span class="line line-3 accent reveal d4">con diseño y tecnología.</span>
        </h1>
      </div>
      <div class="hero-side">
        <p class="lead reveal d5">
          Marca, contenido, herramientas digitales y automatización con IA. No
          entregamos solo un archivo — resolvemos el problema detrás.
        </p>
        <div class="cta-row reveal d6">
          <a class="btn btn-primary" href="#contacto">Cuéntame tu proyecto</a>
          <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
        </div>
        <div class="contraste reveal d7">
          <p class="antes"><span class="mono tag">antes</span> "Te hago una página web."</p>
          <p class="ahora">
            <span class="mono tag accent">ahora</span> Una solución para vender, comunicar
            u operar mejor tu negocio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="wrap">
      <span class="eyebrow mono reveal">Servicios</span>
      <h2 class="reveal">Cuatro líneas. Casi siempre se combinan.</h2>
      <div class="service-list reveal-stagger">
        {
          lineas.map((l) => (
            <div class="service-row">
              <span class="service-index mono">{l.rumbo}</span>
              <h3 class="service-title">{l.titulo}</h3>
              <p class="service-desc">{l.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-deep">
    <div class="wrap">
      <span class="eyebrow mono reveal">Niveles</span>
      <h2 class="reveal">Del tamaño de tu problema.</h2>
      <div class="niveles-row reveal-stagger">
        {
          niveles.map((n, i) => (
            <div class={`nivel-card nivel-${i + 1}`}>
              <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{n.nombre}</h3>
              <p class="precio mono">{n.precio}</p>
              <p class="nivel-desc">{n.desc}</p>
              <p class="nivel-ejemplos">{n.ejemplos}</p>
            </div>
          ))
        }
      </div>
      <p class="nota">
        Precios de referencia para arrancar — cada proyecto se cotiza según
        alcance. También hay servicios mensuales de contenido, diseño y
        automatización, desde $6,000 MXN al mes.
      </p>
    </div>
  </section>

  <section id="portafolio" class="section">
    <div class="wrap">
      <span class="eyebrow mono reveal">Portafolio</span>
      <h2 class="reveal">Seis proyectos. Un problema distinto cada uno.</h2>
      <div class="grid grid-3 portfolio-grid reveal-stagger">
        {
          portafolio.map((p, i) => (
            <div class={`card portfolio-card ${i === 0 || i === 5 ? 'span-2' : ''}`}>
              <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="mono tag accent">{p.tag}</span>
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section section-cta">
    <div class="wrap contacto">
      <span class="eyebrow mono reveal">Contacto</span>
      <h2 class="reveal">Hablemos de tu proyecto.</h2>
      <p class="lead reveal">
        Cuéntame qué necesitas resolver. Te respondo con una propuesta clara
        y sin rodeos.
      </p>
      <div class="cta-row reveal">
        <a
          class="btn btn-primary"
          href="https://wa.me/524433289922"
          target="_blank"
          rel="noopener"
          >Escribir por WhatsApp</a
        >
        <a class="btn btn-ghost" href="mailto:hola@nortecreativo.com"
          >hola@nortecreativo.com</a
        >
      </div>
    </div>
  </section>

  <style>
    .hero-section {
      position: relative;
      overflow: hidden;
    }
    .hero {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
      column-gap: 56px;
      align-items: start;
      padding-top: clamp(64px, 12vh, 140px);
      padding-bottom: clamp(56px, 8vh, 96px);
      transform: translateY(calc(var(--p, 0) * -46px));
      opacity: calc(1 - var(--p, 0) * 0.7);
    }
    .eyebrow {
      display: block;
      color: var(--accent);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }
    /* container-type hace que las líneas del título midan su tamaño
       contra el ancho real de esta columna, no contra el ancho de la
       pantalla completa (con vw, el título se salía de su columna y se
       encimaba con el texto de al lado en pantallas muy anchas). */
    .hero-title-block {
      container-type: inline-size;
      min-width: 0;
    }
    .hero-title {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .hero-title .line {
      display: block;
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 0.98;
      letter-spacing: -0.03em;
    }
    .hero-title .line-1 {
      font-size: clamp(40px, 14.5cqw, 96px);
      font-weight: 900;
    }
    .hero-title .line-2 {
      font-size: clamp(30px, 10cqw, 64px);
      margin-left: clamp(0px, 8cqw, 56px);
      color: var(--muted);
    }
    .hero-title .line-3 {
      font-size: clamp(24px, 7.4cqw, 46px);
      margin-left: clamp(0px, 15cqw, 96px);
      font-style: italic;
      font-weight: 700;
    }
    .hero-side {
      padding-top: clamp(8px, 6vh, 64px);
    }
    .lead {
      color: var(--muted);
      font-size: 19px;
      max-width: 42ch;
      margin: 0 0 36px;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 44px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 15px 28px;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      border-radius: var(--radius-pill);
      border: 1px solid transparent;
      transition: transform 200ms var(--ease-out), background 200ms var(--ease-out),
        border-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
    }
    .btn:active {
      transform: scale(0.97);
    }
    .btn-primary {
      background: var(--accent);
      color: var(--accent-ink);
    }
    @media (hover: hover) and (pointer: fine) {
      .btn-primary:hover {
        box-shadow: 0 16px 36px -12px color-mix(in srgb, var(--accent) 75%, transparent);
        transform: translateY(-2px);
      }
      .btn-ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-2px);
      }
    }
    .btn-ghost {
      color: var(--ink);
      border-color: var(--line);
    }
    .contraste {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px 28px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    .contraste p {
      margin: 0 0 10px;
      font-size: 16px;
    }
    .contraste .antes {
      color: var(--muted);
      text-decoration: line-through;
      text-decoration-color: var(--muted);
      text-decoration-thickness: 1.5px;
    }
    .contraste .ahora {
      color: var(--ink);
      font-weight: 700;
      font-size: 19px;
      margin-bottom: 0;
    }
    .tag {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-right: 10px;
    }
    .tag.accent {
      color: var(--accent);
    }

    .section {
      padding: clamp(64px, 12vh, 140px) 0;
    }
    .section h2 {
      font-size: clamp(28px, 4.4vw, 44px);
      letter-spacing: -0.01em;
      margin: 0 0 40px;
      max-width: 32ch;
    }

    /* Lista editorial de servicios — reemplaza el grid de tarjetas
       iguales por algo que se lee como un índice de revista. */
    .service-list {
      border-top: 1px solid var(--line);
    }
    .service-row {
      position: relative;
      display: grid;
      grid-template-columns: 68px minmax(200px, 1fr) minmax(220px, 1.3fr);
      align-items: baseline;
      gap: 8px 32px;
      padding: 30px 0;
      border-bottom: 1px solid var(--line);
      overflow: hidden;
    }
    .service-index {
      color: var(--muted);
      font-size: 14px;
      transition: color 240ms var(--ease-out);
    }
    .service-title {
      font-size: clamp(20px, 2.4vw, 26px);
      margin: 0;
      transition: color 240ms var(--ease-out), transform 240ms var(--ease-out);
    }
    .service-desc {
      color: var(--muted);
      font-size: 15px;
      margin: 0;
      max-width: 48ch;
    }
    .service-row::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -1px;
      height: 1px;
      width: 0;
      background: var(--accent);
      transition: width 420ms var(--ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .service-row:hover::after {
        width: 100%;
      }
      .service-row:hover .service-index,
      .service-row:hover .service-title {
        color: var(--accent);
      }
      .service-row:hover .service-title {
        transform: translateX(4px);
      }
    }

    /* Franja oscura fija — quiebra el ritmo visual entre secciones,
       como los bloques de contraste que usan sitios de referencia
       (Apple, agencias de diseño): no depende del modo claro/oscuro
       del sistema, siempre se ve como una pausa intencional. */
    .section-deep {
      position: relative;
      overflow: hidden;
      background: var(--deep-bg);
      color: var(--deep-text);
    }
    .section-deep .wrap {
      position: relative;
      z-index: 1;
    }
    .section-deep .eyebrow {
      color: var(--deep-accent);
    }
    .section-deep h2 {
      color: var(--deep-text);
    }

    /* Escalera de niveles: el tamaño y la altura de cada tarjeta crecen
       de Inicio a Lab — la composición representa "del tamaño de tu
       problema" en vez de tres cajas idénticas. */
    .niveles-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      align-items: end;
      margin-bottom: 28px;
    }
    .nivel-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: var(--deep-card);
      border: 1px solid var(--deep-line);
      border-radius: var(--radius);
      padding: 26px 24px 24px;
      transition: border-color 260ms var(--ease-out), box-shadow 260ms var(--ease-out);
    }
    .nivel-1 {
      transform: translateY(48px);
      opacity: 0.92;
    }
    .nivel-2 {
      transform: translateY(16px);
    }
    .nivel-3 {
      padding-top: 40px;
      padding-bottom: 34px;
      border-color: var(--deep-accent);
      box-shadow: 0 30px 60px -32px rgba(0, 0, 0, 0.65);
    }
    .nivel-1 h3 {
      font-size: 18px;
    }
    .nivel-2 h3 {
      font-size: 22px;
    }
    .nivel-3 h3 {
      font-size: 28px;
    }
    .nivel-card h3 {
      color: var(--deep-accent);
      margin-bottom: 2px;
    }
    .card-index {
      position: absolute;
      top: 6px;
      right: 20px;
      z-index: -1;
      font-family: var(--font-display);
      font-size: 72px;
      font-weight: 800;
      color: var(--deep-text);
      opacity: 0.06;
      line-height: 1;
    }
    .precio {
      font-size: 22px;
      color: var(--deep-text);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .nivel-desc {
      color: var(--deep-text);
      font-weight: 600;
      font-size: 15px;
    }
    .nivel-ejemplos {
      color: var(--deep-muted);
      font-size: 14px;
    }
    .nota {
      color: var(--deep-muted);
      font-size: 14px;
      font-style: italic;
      margin-top: 8px;
    }
    @media (hover: hover) and (pointer: fine) {
      .nivel-card:hover {
        border-color: var(--deep-accent);
        box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.6);
      }
    }

    .grid {
      display: grid;
      gap: 22px;
      margin-bottom: 20px;
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .portfolio-grid {
      grid-auto-flow: dense;
    }
    .portfolio-card.span-2 {
      grid-column: span 2;
    }
    .portfolio-card.span-2 h3 {
      font-size: 26px;
    }
    .portfolio-card.span-2 p {
      font-size: 16px;
      max-width: 62ch;
    }

    /* Tarjetas: borde spotlight que sigue al cursor (variables --mx/--my
       actualizadas por JS en Base.astro) en vez de un hover genérico. */
    .card {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      padding: 32px 28px 28px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: transform 260ms var(--ease-out), border-color 260ms var(--ease-out),
        box-shadow 260ms var(--ease-out);
    }
    .card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: radial-gradient(
        260px circle at var(--mx, 50%) var(--my, 50%),
        var(--accent),
        transparent 70%
      );
      opacity: 0;
      transition: opacity 320ms var(--ease-out);
      pointer-events: none;
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
    }
    @media (hover: hover) and (pointer: fine) {
      .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.4);
      }
      .card:hover::before {
        opacity: 1;
      }
    }
    .card-index {
      position: absolute;
      top: 6px;
      right: 20px;
      z-index: -1;
      font-family: var(--font-display);
      font-size: 72px;
      font-weight: 800;
      color: var(--ink);
      opacity: 0.06;
      line-height: 1;
    }
    .card h3 {
      font-size: 19px;
      margin: 0 0 10px;
    }
    .card p {
      color: var(--muted);
      font-size: 15px;
      margin: 0;
    }

    .section-cta {
      position: relative;
      overflow: hidden;
    }
    .section-cta .contacto {
      position: relative;
      z-index: 1;
      max-width: 560px;
    }

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
      }
      .hero-side {
        padding-top: 32px;
      }
      .hero-title .line-2 {
        margin-left: clamp(0px, 8vw, 32px);
      }
      .hero-title .line-3 {
        margin-left: clamp(0px, 14vw, 56px);
      }
    }

    @media (max-width: 780px) {
      .grid-3 {
        grid-template-columns: 1fr;
      }
      .portfolio-card.span-2 {
        grid-column: span 1;
      }
      .niveles-row {
        grid-template-columns: 1fr;
      }
      .nivel-1,
      .nivel-2,
      .nivel-3 {
        transform: none;
        padding: 26px 24px 24px;
      }
      .service-row {
        grid-template-columns: 52px 1fr;
        grid-template-areas: 'idx title' 'desc desc';
        row-gap: 10px;
      }
      .service-index {
        grid-area: idx;
      }
      .service-title {
        grid-area: title;
      }
      .service-desc {
        grid-area: desc;
      }
    }
  </style>
</Base>
