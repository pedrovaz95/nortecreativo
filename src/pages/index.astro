// Fondo del hero: una carta náutica esquemática (círculos de rumbo +
// las cuatro cardinales) — la misma idea del logo, a mucho menor
// volumen, quieta salvo el parallax que ya tenía el hero. Sin esto el
// hero quedaba plano; con un canvas animado de fondo (lo que se quitó
// en el pase anterior) quedaba genérico. Este es el punto medio: una
// sola ilustración fija, con textura, ligada al concepto de marca.
const compassChart = `<svg viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
  <circle cx="200" cy="200" r="180" stroke-width="1"/>
  <circle cx="200" cy="200" r="120" stroke-width="1"/>
  <circle cx="200" cy="200" r="60" stroke-width="1"/>
  <line x1="200" y1="8" x2="200" y2="392" stroke-width="1"/>
  <line x1="8" y1="200" x2="392" y2="200" stroke-width="1"/>
  <line x1="58" y1="58" x2="342" y2="342" stroke-width="1"/>
  <line x1="342" y1="58" x2="58" y2="342" stroke-width="1"/>
  <line x1="200" y1="8" x2="185" y2="44" stroke-width="1.5"/>
  <line x1="200" y1="8" x2="215" y2="44" stroke-width="1.5"/>
</svg>`;
---

<Base
  title="Soluciones de marca, contenido y tecnología para pymes"
  description="Nortecreativo crea soluciones para pequeños negocios combinando creatividad, tecnología e IA — de una marca a una herramienta digital hecha para resolver un problema real."
>
  <section class="hero-section">
    <div class="hero-bg" aria-hidden="true" set:html={compassChart} />
    <div class="hero-cloud" aria-hidden="true">
      <span class="cloud-blob cloud-blob-a"></span>
      <span class="cloud-blob cloud-blob-b"></span>
    </div>
    <div class="hero wrap" data-parallax>
      <div class="hero-title-block">
        <span class="eyebrow mono reveal d1">Nortecreativo</span>
        <h1 class="hero-title">
          <span class="line line-1 reveal d2">Resolvemos</span>
          <span class="line line-2 reveal d3">problemas de negocio</span>
          <span class="line line-3 accent reveal d4">con diseño y tecnología.</span>
        </h1>
      </div>
      <div class="hero-side">
        <p class="lead reveal d5">
          Marca, contenido, herramientas digitales y automatización con IA. No
          entregamos solo un archivo — resolvemos el problema detrás.
        </p>
        <div class="cta-row reveal d6">
          <a class="btn btn-primary" href="#contacto">Cuéntame tu proyecto</a>
          <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
        </div>
        <div class="contraste reveal d7">
          <p class="antes"><span class="mono tag">antes</span> "Te hago una página web."</p>
          <p class="ahora">
            <span class="mono tag accent">ahora</span> Una solución para vender, comunicar
            u operar mejor tu negocio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Nube líquida naranja que sigue el cursor, pero solo dentro del
    // cuadrante del fondo del hero (el mismo espacio donde antes solo
    // había una ilustración fija) — el resto del sitio no cambia. Va
    // detrás del cursor con inercia (no lo sigue de golpe, como si
    // pesara) en vez de pegarse a la posición exacta del mouse. Se
    // desactiva por completo con "reducir movimiento" o en pantallas
    // táctiles (ahí no hay cursor que perseguir).
    (function () {
      // El listener va en toda la sección (no en el cuadrante) porque
      // el grid del hero (.hero) tiene mayor z-index y captura los
      // eventos de mouse aunque esté visualmente vacío ahí — así que
      // en vez de pelear con el orden de capas, se escucha arriba y
      // se decide "¿el cursor está dentro del cuadrante?" comparando
      // coordenadas contra el rectángulo real del fondo.
      var quadrant = document.querySelector('.hero-bg');
      var cloud = document.querySelector('.hero-cloud');
      var section = document.querySelector('.hero-section');
      if (!quadrant || !cloud || !section) return;

      var fineHover =
        window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      var reduce =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!fineHover || reduce) return;

      var blobs = Array.prototype.slice.call(cloud.querySelectorAll('.cloud-blob'));
      var lag = [0.1, 0.06]; // la segunda mancha va más rezagada: da sensación de peso
      var pos = blobs.map(function () {
        return { x: 0, y: 0 };
      });
      var target = { x: 0, y: 0 };
      var running = false;
      var inside = false;

      function loop() {
        blobs.forEach(function (blob, i) {
          pos[i].x += (target.x - pos[i].x) * lag[i];
          pos[i].y += (target.y - pos[i].y) * lag[i];
          blob.style.transform = 'translate(' + pos[i].x.toFixed(1) + 'px,' + pos[i].y.toFixed(1) + 'px)';
        });
        if (running) requestAnimationFrame(loop);
      }

      function leave() {
        inside = false;
        cloud.classList.remove('is-active');
        setTimeout(function () {
          if (!inside) running = false;
        }, 800);
      }

      section.addEventListener(
        'pointermove',
        function (e) {
          var qRect = quadrant.getBoundingClientRect();
          var within =
            e.clientX >= qRect.left &&
            e.clientX <= qRect.right &&
            e.clientY >= qRect.top &&
            e.clientY <= qRect.bottom;

          if (!within) {
            if (inside) leave();
            return;
          }

          var sRect = section.getBoundingClientRect();
          var x = e.clientX - sRect.left;
          var y = e.clientY - sRect.top;

          if (!inside) {
            // recién entra: la nube aparece donde está el cursor, no
            // vuela desde una esquina
            target.x = x;
            target.y = y;
            pos.forEach(function (p) {
              p.x = x;
              p.y = y;
            });
            cloud.classList.add('is-active');
            inside = true;
            if (!running) {
              running = true;
              requestAnimationFrame(loop);
            }
          } else {
            target.x = x;
            target.y = y;
          }
        },
        { passive: true }
      );

      section.addEventListener('pointerleave', function () {
        if (inside) leave();
      });
    })();
  </script>

  <section id="servicios" class="section">
    <div class="wrap">
      <span class="eyebrow mono reveal">Servicios</span>
      <h2 class="reveal">Cuatro líneas. Casi siempre se combinan.</h2>
      <div class="service-list reveal-stagger">
        {
          lineas.map((l) => (
            <div class="service-row">
              <span class="service-index mono">{l.rumbo}</span>
              <h3 class="service-title">{l.titulo}</h3>
              <p class="service-desc">{l.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-deep">
    <div class="wrap">
      <span class="eyebrow mono reveal">Niveles</span>
      <h2 class="reveal">Del tamaño de tu problema.</h2>
      <div class="niveles-row reveal-stagger">
        {
          niveles.map((n, i) => (
            <div class={`nivel-card nivel-${i + 1}`}>
              <span class="card-index mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{n.nombre}</h3>
              <p class="precio mono">{n.precio}</p>
              <p class="nivel-desc">{n.desc}</p>
              <p class="nivel-ejemplos">{n.ejemplos}</p>
            </div>
          ))
        }
      </div>
      <p class="nota">
        Precios de referencia para arrancar — cada proyecto se cotiza según
        alcance. También hay servicios mensuales de contenido, diseño y
        automatización, desde $6,000 MXN al mes.
      </p>
    </div>
  </section>

  <section id="portafolio" class="section">
    <div class="wrap">
      <span class="eyebrow mono reveal">Portafolio</span>
      <h2 class="reveal">Seis proyectos. Un problema distinto cada uno.</h2>
      <div class="portfolio-layout">
        <div class="portfolio-screen" aria-hidden="true">
          <div class="screen-frame">
            <div class="screen-head mono">
              <span class="screen-dot"></span>
              <span>panel — proyecto activo</span>
            </div>
            <div class="screen-body">
              {
                charts.map((chart, i) => (
                  <div class={`screen-chart ${i === 0 ? 'is-active' : ''}`} set:html={chart} />
                ))
              }
            </div>
            <div class="screen-caption mono">
              <span class="screen-caption-index">01</span>
              <span class="screen-caption-title">{portafolio[0].titulo}</span>
            </div>
          </div>
        </div>
        <div class="portfolio-list reveal-stagger">
          {
            portafolio.map((p, i) => (
              <div class="portfolio-row">
                <span class="row-index mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="mono tag accent">{p.tag}</span>
                <h3>{p.titulo}</h3>
                <p>{p.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    // El panel de la derecha muestra un gráfico distinto según qué
    // proyecto de la lista estás leyendo — como el panel de casos de
    // Porto Rocha, que cambia la imagen grande sin mover el layout.
    // En cada scroll (con rAF, sin recalcular más de una vez por
    // frame) se mide qué fila de la lista está más cerca del centro
    // de la pantalla y esa es la que se activa. El cambio en sí es
    // solo opacidad vía CSS, así que no cuesta nada en un teléfono
    // modesto y no rompe si el visitante pidió reducir movimiento.
    (function () {
      var rows = Array.prototype.slice.call(document.querySelectorAll('.portfolio-row'));
      var charts = Array.prototype.slice.call(document.querySelectorAll('.screen-chart'));
      var captionIndex = document.querySelector('.screen-caption-index');
      var captionTitle = document.querySelector('.screen-caption-title');
      if (!rows.length || !charts.length) return;

      var current = 0;

      function activate(i) {
        if (i === current) return;
        current = i;
        charts.forEach(function (c, idx) {
          c.classList.toggle('is-active', idx === i);
        });
        var row = rows[i];
        if (!row || !captionIndex || !captionTitle) return;
        var idxEl = row.querySelector('.row-index');
        var titleEl = row.querySelector('h3');
        if (idxEl) captionIndex.textContent = idxEl.textContent || '';
        if (titleEl) captionTitle.textContent = titleEl.textContent || '';
      }

      function closestToCenter() {
        var center = window.innerHeight / 2;
        var bestIdx = 0;
        var bestDist = Infinity;
        rows.forEach(function (row, idx) {
          var rect = row.getBoundingClientRect();
          var dist = Math.abs(rect.top + rect.height / 2 - center);
          if (dist < bestDist) {
            bestDist = dist;
            bestIdx = idx;
          }
        });
        activate(bestIdx);
      }

      var ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          closestToCenter();
          ticking = false;
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      closestToCenter();
    })();
  </script>

  <section id="contacto" class="section section-cta">
    <div class="wrap contacto">
      <span class="eyebrow mono reveal">Contacto</span>
      <h2 class="reveal">Hablemos de tu proyecto.</h2>
      <p class="lead reveal">
        Cuéntame qué necesitas resolver. Te respondo con una propuesta clara
        y sin rodeos.
      </p>
      <div class="cta-row reveal">
        <a
          class="btn btn-primary"
          href="https://wa.me/524433289922"
          target="_blank"
          rel="noopener"
          >Escribir por WhatsApp</a
        >
        <a class="btn btn-ghost" href="mailto:hola@nortecreativo.com"
          >hola@nortecreativo.com</a
        >
      </div>
    </div>
  </section>

  <style>
    .hero-section {
      position: relative;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      z-index: 0;
      top: -12%;
      right: -10%;
      width: 58%;
      max-width: 760px;
      aspect-ratio: 1 / 1;
      color: var(--ink);
      opacity: 0.08;
      pointer-events: none;
      transform: translateY(calc(var(--p, 0) * -20px));
    }
    .hero-bg :global(svg) {
      width: 100%;
      height: 100%;
    }
    /* Nube líquida: dos manchas radiales muy difuminadas, en modo
       "screen" para mezclarse con el fondo en vez de taparlo. El
       movimiento (inercia, no posición directa) lo pone el script de
       arriba; aquí solo se define la forma y la mezcla de color. No
       se recorta al cuadrante del fondo a propósito — un borde duro
       contradiría la idea de "sin líneas duras". La contiene el
       overflow:hidden de .hero-section, nada más. */
    .hero-cloud {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .cloud-blob {
      position: absolute;
      top: 0;
      left: 0;
      width: 460px;
      height: 460px;
      margin: -230px 0 0 -230px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--accent) 0%, transparent 68%);
      filter: blur(50px);
      opacity: 0;
      mix-blend-mode: screen;
      transition: opacity 600ms var(--ease-out);
      will-change: transform;
    }
    .cloud-blob-b {
      width: 300px;
      height: 300px;
      margin: -150px 0 0 -150px;
      filter: blur(40px);
    }
    .hero-cloud.is-active .cloud-blob-a {
      opacity: 0.5;
    }
    .hero-cloud.is-active .cloud-blob-b {
      opacity: 0.32;
    }
    .hero {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
      column-gap: 56px;
      align-items: start;
      padding-top: clamp(64px, 12vh, 140px);
      padding-bottom: clamp(56px, 8vh, 96px);
      transform: translateY(calc(var(--p, 0) * -46px));
      opacity: calc(1 - var(--p, 0) * 0.7);
    }
    .eyebrow {
      display: block;
      color: var(--accent);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 22px;
    }
    /* container-type hace que las líneas del título midan su tamaño
       contra el ancho real de esta columna, no contra el ancho de la
       pantalla completa (con vw, el título se salía de su columna y se
       encimaba con el texto de al lado en pantallas muy anchas). */
    .hero-title-block {
      container-type: inline-size;
      min-width: 0;
    }
    .hero-title {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .hero-title .line {
      display: block;
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 0.98;
      letter-spacing: -0.03em;
    }
    .hero-title .line-1 {
      font-size: clamp(40px, 14.5cqw, 96px);
      font-weight: 900;
    }
    .hero-title .line-2 {
      font-size: clamp(30px, 10cqw, 64px);
      margin-left: clamp(0px, 8cqw, 56px);
      color: var(--muted);
    }
    .hero-title .line-3 {
      font-size: clamp(24px, 7.4cqw, 46px);
      margin-left: clamp(0px, 15cqw, 96px);
      font-style: italic;
      font-weight: 700;
    }
    .hero-side {
      padding-top: clamp(8px, 6vh, 64px);
    }
    .lead {
      color: var(--muted);
      font-size: 19px;
      max-width: 42ch;
      margin: 0 0 36px;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 44px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 15px 28px;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      border-radius: var(--radius-pill);
      border: 1px solid transparent;
      transition: transform 200ms var(--ease-out), background 200ms var(--ease-out),
        border-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
    }
    .btn:active {
      transform: scale(0.97);
    }
    .btn-primary {
      background: var(--accent);
      color: var(--accent-ink);
    }
    @media (hover: hover) and (pointer: fine) {
      .btn-primary:hover {
        box-shadow: 0 16px 36px -12px color-mix(in srgb, var(--accent) 75%, transparent);
        transform: translateY(-2px);
      }
      .btn-ghost:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-2px);
      }
    }
    .btn-ghost {
      color: var(--ink);
      border-color: var(--line);
    }
    .contraste {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px 28px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    .contraste p {
      margin: 0 0 10px;
      font-size: 16px;
    }
    .contraste .antes {
      color: var(--muted);
      text-decoration: line-through;
      text-decoration-color: var(--muted);
      text-decoration-thickness: 1.5px;
    }
    .contraste .ahora {
      color: var(--ink);
      font-weight: 700;
      font-size: 19px;
      margin-bottom: 0;
    }
    .tag {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-right: 10px;
    }
    .tag.accent {
      color: var(--accent);
    }

    .section {
      padding: clamp(64px, 12vh, 140px) 0;
    }
    .section h2 {
      font-size: clamp(28px, 4.4vw, 44px);
      letter-spacing: -0.01em;
      margin: 0 0 40px;
      max-width: 32ch;
    }

    /* Lista editorial de servicios — reemplaza el grid de tarjetas
       iguales por algo que se lee como un índice de revista. */
    .service-list {
      border-top: 1px solid var(--line);
    }
    .service-row {
      position: relative;
      display: grid;
      grid-template-columns: 68px minmax(200px, 1fr) minmax(220px, 1.3fr);
      align-items: baseline;
      gap: 8px 32px;
      padding: 30px 0;
      border-bottom: 1px solid var(--line);
      overflow: hidden;
    }
    .service-index {
      color: var(--muted);
      font-size: 14px;
      transition: color 240ms var(--ease-out);
    }
    .service-title {
      font-size: clamp(20px, 2.4vw, 26px);
      margin: 0;
      transition: color 240ms var(--ease-out), transform 240ms var(--ease-out);
    }
    .service-desc {
      color: var(--muted);
      font-size: 15px;
      margin: 0;
      max-width: 48ch;
    }
    .service-row::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -1px;
      height: 1px;
      width: 0;
      background: var(--accent);
      transition: width 420ms var(--ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .service-row:hover::after {
        width: 100%;
      }
      .service-row:hover .service-index,
      .service-row:hover .service-title {
        color: var(--accent);
      }
      .service-row:hover .service-title {
        transform: translateX(4px);
      }
    }

    /* Franja oscura fija — quiebra el ritmo visual entre secciones,
       como los bloques de contraste que usan sitios de referencia
       (Apple, agencias de diseño): no depende del modo claro/oscuro
       del sistema, siempre se ve como una pausa intencional. */
    .section-deep {
      position: relative;
      overflow: hidden;
      background-color: var(--deep-bg);
      background-image: radial-gradient(
        circle,
        color-mix(in srgb, var(--deep-line) 70%, transparent) 1px,
        transparent 1px
      );
      background-size: 28px 28px;
      color: var(--deep-text);
    }
    .section-deep .wrap {
      position: relative;
      z-index: 1;
    }
    .section-deep .eyebrow {
      color: var(--deep-accent);
    }
    .section-deep h2 {
      color: var(--deep-text);
    }

    /* Escalera de niveles: el tamaño y la altura de cada tarjeta crecen
       de Inicio a Lab — la composición representa "del tamaño de tu
       problema" en vez de tres cajas idénticas. */
    .niveles-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
      align-items: end;
      margin-bottom: 28px;
    }
    .nivel-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: var(--deep-card);
      border: 1px solid var(--deep-line);
      border-radius: var(--radius);
      padding: 26px 24px 24px;
      transition: border-color 260ms var(--ease-out), box-shadow 260ms var(--ease-out);
    }
    .nivel-1 {
      transform: translateY(48px);
      opacity: 0.92;
    }
    .nivel-2 {
      transform: translateY(16px);
    }
    .nivel-3 {
      padding-top: 40px;
      padding-bottom: 34px;
      border-color: var(--deep-accent);
      box-shadow: 0 30px 60px -32px rgba(0, 0, 0, 0.65);
    }
    .nivel-1 h3 {
      font-size: 18px;
    }
    .nivel-2 h3 {
      font-size: 22px;
    }
    .nivel-3 h3 {
      font-size: 28px;
    }
    .nivel-card h3 {
      color: var(--deep-accent);
      margin-bottom: 2px;
    }
    .card-index {
      position: absolute;
      top: 6px;
      right: 20px;
      z-index: -1;
      font-family: var(--font-display);
      font-size: 72px;
      font-weight: 800;
      color: var(--deep-text);
      opacity: 0.06;
      line-height: 1;
    }
    .precio {
      font-size: 22px;
      color: var(--deep-text);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .nivel-desc {
      color: var(--deep-text);
      font-weight: 600;
      font-size: 15px;
    }
    .nivel-ejemplos {
      color: var(--deep-muted);
      font-size: 14px;
    }
    .nota {
      color: var(--deep-muted);
      font-size: 14px;
      font-style: italic;
      margin-top: 8px;
    }
    @media (hover: hover) and (pointer: fine) {
      .nivel-card:hover {
        border-color: var(--deep-accent);
        box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.6);
      }
    }

    /* Portafolio: en vez de seis tarjetas iguales, una lista editorial
       (misma lógica que Servicios) más un panel fijo a la derecha —
       la referencia es Porto Rocha: la imagen grande no se mueve del
       sitio, solo cambia de contenido según qué caso estás leyendo.
       Aquí el "contenido" es un gráfico técnico por proyecto en vez de
       una foto (todavía no hay fotografía real del trabajo), mostrado
       dentro de un panel con look de instrumento — así el contraste
       oscuro no es un bloque puesto porque sí, es una pantalla que
       responde a lo que estás leyendo. */
    .portfolio-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
      gap: 48px;
      align-items: start;
    }
    .portfolio-list {
      order: 1;
      border-top: 1px solid var(--line);
    }
    .portfolio-row {
      position: relative;
      padding: 26px 0;
      border-bottom: 1px solid var(--line);
    }
    .row-index {
      color: var(--muted);
      font-size: 13px;
    }
    .portfolio-row h3 {
      font-size: 19px;
      margin: 10px 0 8px;
    }
    .portfolio-row p {
      color: var(--muted);
      font-size: 15px;
      margin: 0;
      max-width: 52ch;
    }

    .portfolio-screen {
      order: 2;
      position: sticky;
      top: 110px;
    }
    .screen-frame {
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--deep-card);
      border: 1px solid var(--deep-line);
      box-shadow: 0 30px 60px -32px rgba(0, 0, 0, 0.5);
    }
    .screen-head {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--deep-line);
      font-size: 12px;
      color: var(--deep-muted);
      letter-spacing: 0.04em;
    }
    .screen-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--deep-accent);
      flex: none;
    }
    .screen-body {
      position: relative;
      aspect-ratio: 3 / 2;
      background-image: radial-gradient(
        circle,
        color-mix(in srgb, var(--deep-line) 60%, transparent) 1px,
        transparent 1px
      );
      background-size: 20px 20px;
    }
    .screen-chart {
      position: absolute;
      inset: 0;
      padding: 20px;
      opacity: 0;
      transition: opacity 200ms var(--ease-out);
    }
    .screen-chart.is-active {
      opacity: 1;
    }
    .screen-chart :global(svg) {
      width: 100%;
      height: 100%;
    }
    .screen-caption {
      display: flex;
      gap: 10px;
      align-items: baseline;
      padding: 14px 16px;
      border-top: 1px solid var(--deep-line);
      font-size: 12px;
    }
    .screen-caption-index {
      color: var(--deep-accent);
    }
    .screen-caption-title {
      color: var(--deep-muted);
    }

    .section-cta {
      position: relative;
      overflow: hidden;
    }
    .section-cta .contacto {
      position: relative;
      z-index: 1;
      max-width: 560px;
    }

    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
      }
      .hero-bg {
        width: 78%;
        opacity: 0.06;
      }
      .hero-side {
        padding-top: 32px;
      }
      .hero-title .line-2 {
        margin-left: clamp(0px, 8vw, 32px);
      }
      .hero-title .line-3 {
        margin-left: clamp(0px, 14vw, 56px);
      }
    }

    @media (max-width: 780px) {
      .portfolio-layout {
        display: block;
      }
      .portfolio-screen {
        position: static;
        margin-bottom: 32px;
      }
      .niveles-row {
        grid-template-columns: 1fr;
      }
      .nivel-1,
      .nivel-2,
      .nivel-3 {
        transform: none;
        padding: 26px 24px 24px;
      }
      .service-row {
        grid-template-columns: 52px 1fr;
        grid-template-areas: 'idx title' 'desc desc';
        row-gap: 10px;
      }
      .service-index {
        grid-area: idx;
      }
      .service-title {
        grid-area: title;
      }
      .service-desc {
        grid-area: desc;
      }
    }
  </style>
</Base>
