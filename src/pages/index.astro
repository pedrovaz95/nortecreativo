---
import Base from '../layouts/Base.astro';

const lineas = [
  {
    titulo: 'Marca y contenido',
    desc: 'Identidad visual, piezas para redes, campañas, presentaciones, guiones, video y contenido con apoyo de IA.',
  },
  {
    titulo: 'Experiencias digitales',
    desc: 'Landing pages, micrositios, catálogos digitales, formularios, calculadoras, simuladores y herramientas interactivas.',
  },
  {
    titulo: 'IA y automatización',
    desc: 'Asistentes internos, generación de contenido, flujos de trabajo y automatización de tareas repetitivas.',
  },
  {
    titulo: 'Ventas y capacitación',
    desc: 'Material para equipos comerciales, cursos, guías, recursos de venta y sistemas de consulta.',
  },
];

const niveles = [
  {
    nombre: 'Norte Inicio',
    precio: '$4,000–$10,000 MXN',
    desc: 'Para resolver algo puntual.',
    ejemplos: 'Landing page, presentación comercial, kit para redes, catálogo digital, automatización sencilla.',
  },
  {
    nombre: 'Norte Crece',
    precio: '$10,000–$30,000 MXN',
    desc: 'Para negocios que ya operan.',
    ejemplos: 'Sitio + contenido + automatización, sistema comercial, catálogo interactivo, capacitación, seguimiento.',
  },
  {
    nombre: 'Norte Lab',
    precio: 'Desde $20,000–$25,000 MXN',
    desc: 'Soluciones desde cero, a cotización.',
    ejemplos: 'Simuladores, sistemas internos, apps web ligeras, experiencias con IA, proyectos que mezclan disciplinas.',
  },
];

const portafolio = [
  {
    tag: 'Vender mejor',
    titulo: 'Simulador de ganancias',
    desc: 'Convierte reglas comerciales complejas en una proyección sencilla: el usuario captura sus datos y ve el resultado.',
  },
  {
    tag: 'Vender mejor',
    titulo: 'Calculadora para distribuidores',
    desc: 'Prototipo para proyectar resultados y apoyar conversaciones comerciales con nuevos distribuidores.',
  },
  {
    tag: 'Comunicar mejor',
    titulo: 'Producción de contenido comercial',
    desc: 'Guiones, video, campañas y piezas para redes de una marca de venta directa.',
  },
  {
    tag: 'Capacitar mejor',
    titulo: 'Plataforma de capacitación',
    desc: 'Experiencia de aprendizaje con video, evaluaciones, reconocimientos y seguimiento.',
  },
  {
    tag: 'Operar mejor',
    titulo: 'Registro de eventos por código QR',
    desc: 'Registra asistentes, eventos y regiones, y después ordena la información recolectada.',
  },
  {
    tag: 'Crear algo nuevo',
    titulo: 'Presentación interactiva en la web',
    desc: 'Una presentación tradicional convertida en experiencia web, con navegación y materiales descargables.',
  },
];
---

<Base
  title="Soluciones de marca, contenido y tecnología para pymes"
  description="Nortecreativo crea soluciones para pequeños negocios combinando creatividad, tecnología e IA — de una marca a una herramienta digital hecha para resolver un problema real."
>
  <section class="hero wrap">
    <span class="eyebrow mono">Nortecreativo</span>
    <h1>Resolvemos problemas de negocio con diseño y tecnología.</h1>
    <p class="lead">
      Marca, contenido, herramientas digitales y automatización con IA. No
      entregamos solo un archivo — resolvemos el problema detrás.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#contacto">Cuéntame tu proyecto</a>
      <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
    </div>
    <div class="contraste">
      <p><span class="mono tag">antes</span> "Te hago una página web."</p>
      <p>
        <span class="mono tag accent">ahora</span> Una solución para vender, comunicar
        u operar mejor tu negocio.
      </p>
    </div>
  </section>

  <section id="servicios" class="section">
    <div class="wrap">
      <span class="eyebrow mono">Servicios</span>
      <h2>Cuatro líneas. Casi siempre se combinan.</h2>
      <div class="grid grid-2">
        {
          lineas.map((l) => (
            <div class="card">
              <h3>{l.titulo}</h3>
              <p>{l.desc}</p>
            </div>
          ))
        }
      </div>

      <span class="eyebrow mono niveles-eyebrow">Niveles</span>
      <h2>Del tamaño de tu problema.</h2>
      <div class="grid grid-3">
        {
          niveles.map((n) => (
            <div class="card card-nivel">
              <h3>{n.nombre}</h3>
              <p class="precio mono">{n.precio}</p>
              <p class="nivel-desc">{n.desc}</p>
              <p class="nivel-ejemplos">{n.ejemplos}</p>
            </div>
          ))
        }
      </div>
      <p class="nota">
        Precios de referencia para arrancar — cada proyecto se cotiza según
        alcance. También hay servicios mensuales de contenido, diseño y
        automatización, desde $6,000 MXN al mes.
      </p>
    </div>
  </section>

  <section id="portafolio" class="section alt">
    <div class="wrap">
      <span class="eyebrow mono">Portafolio</span>
      <h2>Seis proyectos. Un problema distinto cada uno.</h2>
      <div class="grid grid-3">
        {
          portafolio.map((p) => (
            <div class="card">
              <span class="mono tag accent">{p.tag}</span>
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contacto" class="section">
    <div class="wrap contacto">
      <span class="eyebrow mono">Contacto</span>
      <h2>Hablemos de tu proyecto.</h2>
      <p class="lead">
        Cuéntame qué necesitas resolver. Te respondo con una propuesta clara
        y sin rodeos.
      </p>
      <!-- TODO: cambiar por el correo o WhatsApp real de Pedro -->
      <a class="btn btn-primary" href="mailto:hola@nortecreativo.com"
        >Escribir a hola@nortecreativo.com</a
      >
    </div>
  </section>

  <style>
    .hero {
      padding: 80px 0 60px;
      max-width: 680px;
    }
    .eyebrow {
      display: block;
      color: var(--accent);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 18px;
    }
    h1 {
      font-size: clamp(30px, 5vw, 44px);
      margin-bottom: 18px;
    }
    .lead {
      color: var(--muted);
      font-size: 18px;
      max-width: 56ch;
      margin: 0 0 32px;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 40px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      padding: 13px 24px;
      font-family: var(--font-body);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      border-radius: 4px;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: var(--accent);
      color: var(--accent-ink);
    }
    .btn-ghost {
      color: var(--ink);
      border-color: var(--line);
    }
    .contraste {
      border-top: 1px solid var(--line);
      padding-top: 24px;
    }
    .contraste p {
      margin: 0 0 8px;
      color: var(--muted);
      font-size: 15px;
    }
    .contraste p:last-child {
      color: var(--ink);
      font-weight: 600;
      margin-bottom: 0;
    }
    .tag {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-right: 10px;
    }
    .tag.accent {
      color: var(--accent);
    }

    .section {
      padding: 72px 0;
    }
    .section.alt {
      background: var(--surface);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .section h2 {
      font-size: clamp(24px, 3.6vw, 32px);
      margin: 0 0 32px;
      max-width: 32ch;
    }
    .niveles-eyebrow {
      margin-top: 56px;
    }

    .grid {
      display: grid;
      gap: 20px;
      margin-bottom: 20px;
    }
    .grid-2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .card {
      border: 1px solid var(--line);
      background: var(--surface);
      padding: 26px;
    }
    .section.alt .card {
      background: var(--bg);
    }
    .card h3 {
      font-size: 18px;
      margin: 0 0 10px;
    }
    .card p {
      color: var(--muted);
      font-size: 15px;
      margin: 0;
    }
    .card-nivel {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .card-nivel h3 {
      color: var(--accent);
      margin-bottom: 2px;
    }
    .precio {
      font-size: 15px;
      color: var(--ink);
      font-weight: 600;
    }
    .nivel-desc {
      color: var(--ink);
      font-weight: 600;
      font-size: 15px;
    }
    .nivel-ejemplos {
      color: var(--muted);
      font-size: 14px;
    }
    .nota {
      color: var(--muted);
      font-size: 14px;
      font-style: italic;
      margin-top: 8px;
    }

    .contacto {
      max-width: 560px;
    }

    @media (max-width: 780px) {
      .grid-2,
      .grid-3 {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
