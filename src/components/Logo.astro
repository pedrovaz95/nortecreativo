---
// La aguja de brújula, más el wordmark opcional.
// Colores fijos a propósito (no usan las variables del tema): el logo
// no se invierte con el modo oscuro del visitante, siempre se ve igual
// a sí mismo. Por eso recibe la variante "onDark" en vez de heredar tokens.
interface Props {
  withWordmark?: boolean;
  onDark?: boolean;
  size?: number;
}

const { withWordmark = true, onDark = false, size = 40 } = Astro.props;

const inkColor = onDark ? '#f2f1ed' : '#15161b';
const bgColor = onDark ? '#15161b' : '#ffffff';
const accentColor = onDark ? '#ff9a2e' : '#ff8a00';
const mutedColor = onDark ? '#9a9da6' : '#63666d';
---

<span class="logo">
  <svg
    class="logo-mark"
    style={`width:${size}px;height:${size}px`}
    viewBox="0 0 100 100"
    role="img"
    aria-label="Nortecreativo"
  >
    <g transform="rotate(18 50 50)">
      <polygon points="50,4 62,52 38,52" fill={accentColor}></polygon>
      <polygon points="50,96 62,52 38,52" fill={inkColor}></polygon>
      <circle cx="50" cy="52" r="5.5" fill={bgColor} stroke={inkColor} stroke-width="2.5"
      ></circle>
    </g>
  </svg>
  {
    withWordmark && (
      <span class="logo-word" style={`color:${inkColor}`}>
        norte<span style={`color:${mutedColor}; font-weight:700`}>creativo</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .logo-mark {
    flex: none;
  }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
</style>
