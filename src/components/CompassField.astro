---
// Fondo generativo de marca: un campo de "agujas" que por defecto apuntan
// al norte y se reorientan hacia el cursor, como limaduras de hierro cerca
// de un imán. Es el mismo lenguaje visual del logo (la aguja de brújula),
// convertido en un fondo vivo — no un blob difuminado genérico.
// Se repite en el hero, la franja oscura de niveles y contacto, para que
// funcione como firma visual del sitio, no como efecto de una sola vez.
interface Props {
  variant?: 'light' | 'deep';
}
const { variant = 'light' } = Astro.props;
---

<canvas
  class={`compass-field ${variant === 'deep' ? 'compass-field-deep' : ''}`}
  aria-hidden="true"
></canvas>

<style>
  .compass-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
</style>

<script>
  (function () {
    var reduce =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function hexToRgb(hex: string) {
      var h = (hex || '').trim().replace('#', '');
      if (h.length === 3) {
        h = h
          .split('')
          .map(function (c) {
            return c + c;
          })
          .join('');
      }
      var num = parseInt(h || '888888', 16);
      return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
    }

    function initField(canvas: HTMLCanvasElement) {
      var ctx = canvas.getContext('2d');
      if (!ctx) return;
      var deep = canvas.classList.contains('compass-field-deep');
      var dpr = Math.min(window.devicePixelRatio || 1, 2);
      var needles: { x: number; y: number; angle: number; rest: number; seed: number }[] =
        [];
      var pointer = { x: -9999, y: -9999, active: false };
      var w = 0;
      var h = 0;
      var accentRgb = [255, 138, 0];
      var mutedRgb = [99, 102, 109];
      var rafId: number | null = null;

      function readColors() {
        var styles = getComputedStyle(document.documentElement);
        accentRgb = hexToRgb(
          styles.getPropertyValue(deep ? '--deep-accent' : '--accent')
        );
        mutedRgb = hexToRgb(
          styles.getPropertyValue(deep ? '--deep-muted' : '--muted')
        );
      }

      function buildNeedles() {
        var rect = canvas.getBoundingClientRect();
        w = Math.max(rect.width, 1);
        h = Math.max(rect.height, 1);
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        var spacing = 78;
        var cols = Math.ceil(w / spacing) + 1;
        var rows = Math.ceil(h / spacing) + 1;
        needles = [];
        for (var i = 0; i < cols; i++) {
          for (var j = 0; j < rows; j++) {
            var jitterX = (Math.random() - 0.5) * spacing * 0.75;
            var jitterY = (Math.random() - 0.5) * spacing * 0.75;
            needles.push({
              x: i * spacing + jitterX,
              y: j * spacing + jitterY,
              angle: 0,
              // Reposo orgánico: cada aguja descansa con una leve inclinación
              // propia en vez de todas perfectamente verticales — así el
              // campo se ve disperso y con carácter, no como una textura de
              // rayas parejas.
              rest: (Math.random() - 0.5) * 0.85,
              seed: Math.random() * Math.PI * 2,
            });
          }
        }
      }

      function frame(t: number) {
        ctx!.clearRect(0, 0, w, h);
        var radius = 210;
        for (var k = 0; k < needles.length; k++) {
          var n = needles[k];
          var dx = pointer.x - n.x;
          var dy = pointer.y - n.y;
          var dist = Math.sqrt(dx * dx + dy * dy);
          var target = reduce ? n.rest : n.rest + Math.sin(t * 0.00022 + n.seed) * 0.16;
          var influence = 0;
          if (!reduce && pointer.active && dist < radius) {
            target = Math.atan2(dy, dx) + Math.PI / 2;
            influence = 1 - dist / radius;
          }
          var diff = target - n.angle;
          while (diff > Math.PI) diff -= Math.PI * 2;
          while (diff < -Math.PI) diff += Math.PI * 2;
          n.angle += diff * (reduce ? 1 : 0.07);

          var len = 7 + influence * 8;
          var dxv = Math.sin(n.angle) * len;
          var dyv = -Math.cos(n.angle) * len;

          var r = mutedRgb[0] + (accentRgb[0] - mutedRgb[0]) * influence;
          var g = mutedRgb[1] + (accentRgb[1] - mutedRgb[1]) * influence;
          var b = mutedRgb[2] + (accentRgb[2] - mutedRgb[2]) * influence;
          var alpha = (deep ? 0.28 : 0.16) + influence * 0.55;

          ctx!.strokeStyle =
            'rgba(' +
            r.toFixed(0) +
            ',' +
            g.toFixed(0) +
            ',' +
            b.toFixed(0) +
            ',' +
            alpha.toFixed(2) +
            ')';
          ctx!.lineWidth = 1.3;
          ctx!.lineCap = 'round';
          ctx!.beginPath();
          ctx!.moveTo(n.x - dxv, n.y - dyv);
          ctx!.lineTo(n.x + dxv, n.y + dyv);
          ctx!.stroke();
        }

        if (!reduce) rafId = requestAnimationFrame(frame);
      }

      function start() {
        readColors();
        buildNeedles();
        if (reduce) {
          frame(0);
          return;
        }
        rafId = requestAnimationFrame(frame);
      }

      function stop() {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
      }

      window.addEventListener(
        'pointermove',
        function (e) {
          var rect = canvas.getBoundingClientRect();
          pointer.x = e.clientX - rect.left;
          pointer.y = e.clientY - rect.top;
          pointer.active =
            pointer.x > -80 &&
            pointer.x < w + 80 &&
            pointer.y > -80 &&
            pointer.y < h + 80;
        },
        { passive: true }
      );

      window.addEventListener('pointerleave', function () {
        pointer.active = false;
      });

      var resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(buildNeedles, 150);
      });

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          stop();
        } else if (!reduce && rafId === null) {
          rafId = requestAnimationFrame(frame);
        }
      });

      if (window.matchMedia) {
        window
          .matchMedia('(prefers-color-scheme: dark)')
          .addEventListener('change', readColors);
      }

      start();
    }

    document
      .querySelectorAll<HTMLCanvasElement>('canvas.compass-field')
      .forEach(initField);
  })();
</script>
